---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import PixelField from './PixelField.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  /** Play the project's short loop over the card image (homepage only,
   * where the "Pause motion" control lives). */
  animate?: boolean;
}

const { project, animate = false } = Astro.props;
const { title, kicker, summary, hero, heroAlt, loop } = project.data;
// The video is decorative: the image underneath carries the alt text and
// stays as the no-JS, reduced-motion, and paused state. Its src is only set
// by script once motion is allowed, so nothing downloads otherwise.
const loopSrc = animate && hero && loop ? withBase(loop) : undefined;
---

<a class="card" href={withBase(`/work/${project.id}/`)}>
  {
    hero ? (
      <div class="media">
        <Image
          src={hero}
          alt={heroAlt ?? ''}
          width={880}
          widths={[440, 880]}
          sizes="(max-width: 720px) 100vw, 45vw"
          transition:name={`work-hero-${project.id}`}
        />
        {loopSrc && (
          <video
            class="loop"
            data-loop-src={loopSrc}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
      </div>
    ) : (
      <div class="thumb-field">
        <PixelField />
      </div>
    )
  }
  <div class="body">
    <p class="tag">{kicker}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    background: var(--mist);
    border: 1px solid var(--mist-line);
  }

  .media {
    position: relative;
    overflow: hidden;
  }

  .card img,
  .loop {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* The loop fades in over the still once it is actually playing. */
  .loop {
    position: absolute;
    inset: 0;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .loop.is-playing {
    opacity: 1;
  }

  /* Projects still awaiting photography get the brand's pixel field. */
  .thumb-field {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--mist);
    border-bottom: 1px solid var(--mist-line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card img,
    .loop {
      transition:
        transform 0.6s ease,
        opacity 0.5s ease;
    }

    .card:hover img,
    .card:focus-visible img,
    .card:hover .loop,
    .card:focus-visible .loop {
      transform: scale(1.04);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 30px 30px;
  }

  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-text);
  }

  h3 {
    font-size: 1.75rem;
  }

  .card:hover h3 {
    color: var(--cyan-text);
  }

  .summary {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
