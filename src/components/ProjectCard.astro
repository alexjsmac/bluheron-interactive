---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, kicker, summary, hero, heroAlt } = project.data;
---

<a class="card" href={withBase(`/work/${project.id}/`)}>
  <Image
    src={hero}
    alt={heroAlt}
    width={880}
    widths={[440, 880]}
    sizes="(max-width: 720px) 100vw, 45vw"
    transition:name={`work-hero-${project.id}`}
  />
  <div class="body">
    <p class="tag">{kicker}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    background: var(--mist);
    border: 1px solid var(--mist-line);
  }

  .card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card img {
      transition: transform 0.6s ease;
    }

    .card:hover img,
    .card:focus-visible img {
      transform: scale(1.04);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 30px 30px;
  }

  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-text);
  }

  h3 {
    font-size: 1.75rem;
  }

  .card:hover h3 {
    color: var(--cyan-text);
  }

  .summary {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
