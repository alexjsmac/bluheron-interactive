---
/**
 * The signature moment: the logo's pixel-dissolve wing as a living field.
 * Grid-locked pixels twinkle and drift across a pale heron mist; lit pixels
 * bend gently toward the pointer, and a tap sends a beacon ripple through the
 * grid, lighting pixels as it passes. The copy carves a quiet zone out of the
 * field — pixels fade out behind text — so type always sits on clean ground.
 * Motion is a progressive enhancement — the static pixel scatter underneath
 * is the designed reduced-motion (and no-JS) experience, not a degraded one.
 */
interface Props {
  /** Landing-page mode: the band claims most of the viewport. */
  tall?: boolean;
}

const { tall = false } = Astro.props;
import PixelEdge from './PixelEdge.astro';

// The designed still: a deterministic sparse pixel scatter (no Math.random,
// so builds are reproducible). Shown whenever the canvas isn't animating.
const CELL = 18;
const SQ = 11;
const COLS = 80;
const ROWS = 42;

const hash = (n: number) => {
  let x = (n ^ 61) ^ (n >>> 16);
  x = (x + (x << 3)) | 0;
  x = x ^ (x >>> 4);
  x = Math.imul(x, 0x27d4eb2d);
  x = x ^ (x >>> 15);
  return (x >>> 0) % 1000;
};

const STILL_COLORS = ['#0097b2', '#0097b2', '#4fc9dc', '#b4652f', '#c85981'];

type Cell = { x: number; y: number; c: string; o: number };
const cells: Cell[] = [];
for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    const h = hash(col * 137 + row * 613 + 11);
    if (h < 52) {
      cells.push({
        x: col * CELL,
        y: row * CELL,
        c: STILL_COLORS[h % STILL_COLORS.length],
        o: 0.14 + (h % 37) / 100,
      });
    }
  }
}
---

<div class:list={['hero-band', 'band', { 'is-tall': tall }]}>
  <svg
    class="pixel-still"
    viewBox={`0 0 ${COLS * CELL} ${ROWS * CELL}`}
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    {cells.map((c) => <rect x={c.x} y={c.y} width={SQ} height={SQ} fill={c.c} opacity={c.o} />)}
  </svg>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content wrap">
    <slot />
    <div class="hero-controls">
      <button class="motion-toggle" type="button" hidden aria-pressed="false">
      <svg
        class="icon-pause"
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <rect x="3" y="2.5" width="3.5" height="11" rx="1"></rect>
        <rect x="9.5" y="2.5" width="3.5" height="11" rx="1"></rect>
      </svg>
      <svg
        class="icon-play"
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M4 2.5 L13 8 L4 13.5 Z"></path>
      </svg>
        <span class="label">Pause motion</span>
      </button>
    </div>
  </div>
  <PixelEdge />
</div>

<style>
  .hero-band {
    position: relative;
    overflow: hidden;
    background-color: var(--mist);
    background-image: radial-gradient(
      ellipse 900px 500px at 75% 20%,
      rgba(0, 151, 178, 0.07),
      transparent 70%
    );
  }

  .pixel-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 1.2s ease;
  }

  .hero-band.is-animating .pixel-still {
    opacity: 0;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero-canvas.is-running {
    opacity: 1;
  }

  .hero-content {
    position: relative;
    width: 100%;
    padding-block: clamp(72px, 10vw, 128px) clamp(56px, 7vw, 96px);
  }

  /* Landing mode: the band is the opening stage, not a strip. */
  .hero-band.is-tall {
    display: flex;
    align-items: center;
    min-height: 86vh;
    min-height: 86svh;
  }

  .hero-band.is-tall .hero-content {
    padding-block: clamp(96px, 12vh, 160px);
  }

  @media (max-width: 720px) {
    .hero-content,
    .hero-band.is-tall .hero-content {
      /* Bottom padding clears the motion chip, which is absolutely
         positioned in the band's corner. */
      padding-block: clamp(40px, 7vh, 64px) clamp(44px, 8vh, 72px);
    }
  }

  /* In normal flow, not anchored to the band's bottom edge. The band's height
     tracks the viewport, so anything pinned to its bottom drifts against the
     vertically-centred content as mobile browser chrome collapses. */
  .hero-controls {
    display: flex;
    justify-content: flex-end;
    /* vw, not vh: viewport-height units shift when mobile chrome collapses. */
    margin-top: clamp(28px, 5vw, 44px);
  }

  /* The logo's pixel dissolve, seaming the band into the paper below. */
  .hero-band :global(.pixel-edge) {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
  }

  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid var(--mist-line);
    border-radius: 999px;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 18px;
    min-height: 44px;
    cursor: pointer;
  }

  .motion-toggle:hover {
    color: var(--cyan-deep);
    border-color: var(--cyan);
  }

  .motion-toggle .icon-play,
  .motion-toggle[aria-pressed='false'] .icon-pause {
    display: block;
  }

  .motion-toggle .icon-pause,
  .motion-toggle[aria-pressed='false'] .icon-play {
    display: none;
  }

  .motion-toggle[aria-pressed='false'] .icon-play {
    display: none;
  }

  .motion-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  .motion-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }
</style>

<script>
  type Ripple = { x: number; y: number; r: number; alpha: number };

  // With the ClientRouter, this module executes once per site visit, not per
  // page — initHero() re-runs setup on every navigation via astro:page-load,
  // and this cleanup tears down the previous page's loop/observer/listener.
  let cleanup: (() => void) | null = null;

  function initHero() {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const band = document.querySelector<HTMLElement>('.hero-band');
    if (!band) {
      return;
    }

    const canvas = band.querySelector<HTMLCanvasElement>('.hero-canvas');
    const toggle = band.querySelector<HTMLButtonElement>('.motion-toggle');
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    if (!canvas || !toggle || !motionOK) {
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) {
      return;
    }

    // The logo wing's palette: heron cyans with rare clay and magenta pixels.
    const COLORS = ['#0097b2', '#0097b2', '#0097b2', '#4fc9dc', '#00758c', '#b4652f', '#c85981'];
    const CELL = 14;
    const SQ = 9;
    const THRESHOLD = 0.88;

    let w = 0;
    let h = 0;
    let cols = 0;
    let rows = 0;
    let dpr = 1;
    let raf = 0;
    let inView = true;
    const pointer = { x: -9999, y: -9999 };
    // The pull trails the cursor with a soft lag, so the field feels magnetic
    // rather than switched.
    const drift = { x: -9999, y: -9999 };
    let ripples: Ripple[] = [];

    const cellHash = (n: number) => {
      let x = (n ^ 61) ^ (n >>> 16);
      x = (x + (x << 3)) | 0;
      x = x ^ (x >>> 4);
      x = Math.imul(x, 0x27d4eb2d);
      x = x ^ (x >>> 15);
      return x >>> 0;
    };

    // Rects the hero copy occupies, in band-local coordinates. Pixels fade
    // to nothing inside these and ramp back up across FEATHER px outside, so
    // text never has to compete with the field for contrast.
    const FEATHER = 44;
    const PAD = 6;
    let quietRects: { l: number; t: number; r: number; b: number }[] = [];

    const measureQuiet = () => {
      const bandBox = band.getBoundingClientRect();
      const nodes = band.querySelectorAll<HTMLElement>(
        '.hero-content p, .hero-content h1, .hero-content h2, .hero-content .btn, .hero-content .arrow-link'
      );
      quietRects = [...nodes].map((el) => {
        const r = el.getBoundingClientRect();
        return {
          l: r.left - bandBox.left - PAD,
          t: r.top - bandBox.top - PAD,
          r: r.right - bandBox.left + PAD,
          b: r.bottom - bandBox.top + PAD,
        };
      });
    };

    // 0 inside the copy, ramping to 1 once clear of it.
    const quietAt = (x: number, y: number) => {
      let q = 1;
      for (const rect of quietRects) {
        const dx = Math.max(rect.l - x, 0, x - rect.r);
        const dy = Math.max(rect.t - y, 0, y - rect.b);
        if (dx >= FEATHER || dy >= FEATHER) continue;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d >= FEATHER) continue;
        const f = d / FEATHER;
        if (f < q) q = f;
        if (q === 0) break;
      }
      return q;
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = band.clientWidth;
      h = band.clientHeight;
      cols = Math.ceil(w / CELL);
      rows = Math.ceil(h / CELL);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      measureQuiet();
    };

    // Slow breathing field: which pixels are awake drifts over time.
    // The per-cell hash phase breaks the waves into dappled clusters, so the
    // field reads as the wing dissolving rather than as moving stripes.
    const field = (cx: number, cy: number, t: number, phase: number) => {
      return (
        0.5 +
        0.5 *
          Math.sin(
            cx * 0.23 +
              cy * 0.37 +
              phase * 6.28 +
              Math.sin(cx * 0.09 - t * 0.00019) * 1.8 +
              Math.cos(cy * 0.11 + t * 0.00015) * 1.8
          )
      );
    };

    const PULL_R = 260;
    const PULL_MAX = 13;

    const step = (now: number) => {
      ctx.clearRect(0, 0, w, h);

      if (drift.x < -5000) {
        drift.x = pointer.x;
        drift.y = pointer.y;
      } else {
        drift.x += (pointer.x - drift.x) * 0.07;
        drift.y += (pointer.y - drift.y) * 0.07;
      }

      for (let cy = 0; cy < rows; cy++) {
        for (let cx = 0; cx < cols; cx++) {
          const hsh = cellHash(cx * 137 + cy * 613);
          // Most cells never light at all — sparseness is the design.
          const eligible = hsh % 100 < 38;
          const v = eligible ? field(cx, cy, now, (hsh % 97) / 97) : 0;
          let a = v > THRESHOLD ? ((v - THRESHOLD) / (1 - THRESHOLD)) * 0.42 : 0;

          const px = cx * CELL + CELL / 2;
          const py = cy * CELL + CELL / 2;

          // Beacon ripples light pixels as the ring front passes through.
          for (const rp of ripples) {
            const dist = Math.sqrt((px - rp.x) ** 2 + (py - rp.y) ** 2);
            if (Math.abs(dist - rp.r) < 22) {
              a = Math.max(a, rp.alpha * 0.85);
            }
          }

          if (a > 0.02) {
            // Lit pixels bend gently toward the cursor — never brighter,
            // never denser, just pulled a little off their grid.
            let ox = 0;
            let oy = 0;
            const dx = drift.x - px;
            const dy = drift.y - py;
            const d2 = dx * dx + dy * dy;
            if (d2 < PULL_R * PULL_R) {
              const d = Math.sqrt(d2) || 1;
              const t = 1 - d / PULL_R;
              const pull = t * t * PULL_MAX;
              ox = (dx / d) * pull;
              oy = (dy / d) * pull;
            }

            // Measured where the pixel actually lands, so a pulled pixel
            // can't drift in behind the copy.
            a *= quietAt(px + ox, py + oy);
            if (a <= 0.02) continue;

            ctx.globalAlpha = Math.min(a, 0.8);
            ctx.fillStyle = COLORS[hsh % COLORS.length];
            ctx.fillRect(cx * CELL + 2 + ox, cy * CELL + 2 + oy, SQ, SQ);
          }
        }
      }
      ctx.globalAlpha = 1;

      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        rp.r += 3;
        rp.alpha -= 0.008;
        if (rp.alpha <= 0) {
          ripples.splice(i, 1);
        }
      }

      raf = requestAnimationFrame(step);
    };

    let userPaused = false;
    try {
      userPaused = localStorage.getItem('hero-motion') === 'off';
    } catch {}

    const running = () => raf !== 0;

    const start = () => {
      if (!running() && inView && !userPaused) {
        raf = requestAnimationFrame(step);
        canvas.classList.add('is-running');
        band.classList.add('is-animating');
      }
    };

    const stop = () => {
      if (running()) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    const paint = () => {
      toggle.setAttribute('aria-pressed', String(userPaused));
      const label = toggle.querySelector('.label');
      if (label) label.textContent = userPaused ? 'Play motion' : 'Pause motion';
      canvas.classList.toggle('is-running', !userPaused);
      band.classList.toggle('is-animating', !userPaused);
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      try {
        localStorage.setItem('hero-motion', userPaused ? 'off' : 'on');
      } catch {}
      if (userPaused) stop();
      else start();
      paint();
    });

    band.addEventListener('pointermove', (e) => {
      const rect = band.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
    });
    band.addEventListener('pointerleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });

    // Tap/click the band to send out a beacon ripple — skip taps on
    // interactive children so links, buttons, and inputs stay clickable.
    band.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button, input')) return;
      const rect = band.getBoundingClientRect();
      ripples.push({
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
        r: 0,
        alpha: 1,
      });
      if (ripples.length > 6) ripples.shift();
    });

    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      },
      { threshold: 0.05 }
    );
    io.observe(band);

    window.addEventListener('resize', resize);
    resize();
    if (document.fonts?.ready) document.fonts.ready.then(measureQuiet);
    paint();
    start();

    cleanup = () => {
      stop();
      io.disconnect();
      window.removeEventListener('resize', resize);
    };
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
