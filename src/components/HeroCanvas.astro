---
/**
 * The signature moment: a generative heron-blue particle field.
 * Motion is a progressive enhancement — the static gradient underneath is the
 * designed reduced-motion (and no-JS) experience, not a degraded one.
 */
---

<div class="hero-band band">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content wrap">
    <slot />
  </div>
  <div class="hero-controls wrap">
    <button class="motion-toggle" type="button" hidden aria-pressed="false">
      <svg
        class="icon-pause"
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <rect x="3" y="2.5" width="3.5" height="11" rx="1"></rect>
        <rect x="9.5" y="2.5" width="3.5" height="11" rx="1"></rect>
      </svg>
      <svg
        class="icon-play"
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M4 2.5 L13 8 L4 13.5 Z"></path>
      </svg>
      <span class="label">Pause motion</span>
    </button>
  </div>
</div>

<style>
  .hero-band {
    position: relative;
    overflow: hidden;
    /* The designed still: soft aurora glows + a scatter of fixed particles. */
    background-image:
      radial-gradient(ellipse 620px 400px at 78% 18%, rgba(0, 151, 178, 0.22), transparent 70%),
      radial-gradient(ellipse 500px 360px at 12% 82%, rgba(169, 232, 220, 0.1), transparent 70%),
      radial-gradient(circle 2.5px at 15% 32%, rgba(169, 232, 220, 0.9), transparent 100%),
      radial-gradient(circle 2px at 33% 58%, rgba(79, 201, 220, 0.8), transparent 100%),
      radial-gradient(circle 3px at 65% 24%, rgba(169, 232, 220, 0.7), transparent 100%),
      radial-gradient(circle 2px at 82% 74%, rgba(79, 201, 220, 0.85), transparent 100%),
      radial-gradient(circle 2.5px at 50% 88%, rgba(169, 232, 220, 0.6), transparent 100%),
      radial-gradient(circle 1.5px at 24% 82%, rgba(234, 244, 244, 0.6), transparent 100%),
      radial-gradient(circle 2px at 92% 44%, rgba(234, 244, 244, 0.5), transparent 100%),
      radial-gradient(circle 1.5px at 73% 92%, rgba(169, 232, 220, 0.7), transparent 100%),
      radial-gradient(circle 2px at 9% 60%, rgba(79, 201, 220, 0.6), transparent 100%);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero-canvas.is-running {
    opacity: 1;
  }

  .hero-content {
    position: relative;
    padding-block: clamp(72px, 10vw, 128px) clamp(40px, 5vw, 64px);
  }

  .hero-controls {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding-bottom: 28px;
  }

  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 16, 22, 0.5);
    border: 1px solid var(--band-line);
    border-radius: 999px;
    color: var(--band-muted);
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 18px;
    min-height: 44px;
    cursor: pointer;
  }

  .motion-toggle:hover {
    color: var(--mint);
    border-color: var(--band-muted);
  }

  .motion-toggle .icon-play,
  .motion-toggle[aria-pressed='false'] .icon-pause {
    display: block;
  }

  .motion-toggle .icon-pause,
  .motion-toggle[aria-pressed='false'] .icon-play {
    display: none;
  }

  .motion-toggle[aria-pressed='false'] .icon-play {
    display: none;
  }

  .motion-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  .motion-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }
</style>

<script>
  type P = { x: number; y: number; vx: number; vy: number; r: number; c: string; a: number };
  type Ripple = { x: number; y: number; r: number; alpha: number };

  // With the ClientRouter, this module executes once per site visit, not per
  // page — initHero() re-runs setup on every navigation via astro:page-load,
  // and this cleanup tears down the previous page's loop/observer/listener.
  let cleanup: (() => void) | null = null;

  function initHero() {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const band = document.querySelector<HTMLElement>('.hero-band');
    if (!band) {
      return;
    }

    const canvas = band.querySelector<HTMLCanvasElement>('.hero-canvas');
    const toggle = band.querySelector<HTMLButtonElement>('.motion-toggle');
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    if (!canvas || !toggle || !motionOK) {
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) {
      return;
    }

    const COLORS = ['rgba(79,201,220,', 'rgba(169,232,220,', 'rgba(0,151,178,', 'rgba(234,244,244,'];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let inView = true;
    const pointer = { x: -9999, y: -9999 };

    let particles: P[] = [];
    let ripples: Ripple[] = [];

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = band.clientWidth;
      h = band.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(160, Math.floor((w * h) / 14000));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: 0,
        vy: 0,
        r: 0.6 + Math.random() * 1.8,
        c: COLORS[Math.floor(Math.random() * COLORS.length)],
        a: 0.25 + Math.random() * 0.55,
      }));
    };

    // Cheap divergence-free-ish flow field from layered sines.
    const flow = (x: number, y: number, time: number) => {
      const s = 0.0016;
      const ang =
        Math.sin(x * s * 1.3 + time * 0.00022) * 1.6 +
        Math.cos(y * s * 1.7 - time * 0.00018) * 1.6 +
        Math.sin((x + y) * s * 0.6 + time * 0.0001) * 1.2;
      return ang;
    };

    const step = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const p of particles) {
        const ang = flow(p.x, p.y, now);
        p.vx += Math.cos(ang) * 0.014;
        p.vy += Math.sin(ang) * 0.012;

        const dx = p.x - pointer.x;
        const dy = p.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 22500) {
          const f = (1 - d2 / 22500) * 0.35;
          const d = Math.sqrt(d2) || 1;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }

        // Beacon ripples: particles riding near the expanding ring front get
        // a gentle outward push, proportional to how strong the ring still is.
        for (const rp of ripples) {
          const rdx = p.x - rp.x;
          const rdy = p.y - rp.y;
          const dist = Math.sqrt(rdx * rdx + rdy * rdy) || 1;
          if (Math.abs(dist - rp.r) < 28) {
            const push = 0.5 * rp.alpha;
            p.vx += (rdx / dist) * push;
            p.vy += (rdy / dist) * push;
          }
        }

        p.vx *= 0.965;
        p.vy *= 0.965;
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < -12) p.x = w + 12;
        if (p.x > w + 12) p.x = -12;
        if (p.y < -12) p.y = h + 12;
        if (p.y > h + 12) p.y = -12;

        const tw = 0.75 + 0.25 * Math.sin(now * 0.001 + p.x * 0.05);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.c + p.a * tw + ')';
        ctx.fill();
      }

      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        rp.r += 2.4;
        rp.alpha -= 0.006;
        if (rp.alpha <= 0) {
          ripples.splice(i, 1);
          continue;
        }

        ctx.beginPath();
        ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(169,232,220,' + rp.alpha * 0.5 + ')';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Inner ring for depth.
        ctx.beginPath();
        ctx.arc(rp.x, rp.y, rp.r * 0.7, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(169,232,220,' + rp.alpha * 0.25 + ')';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      raf = requestAnimationFrame(step);
    };

    let userPaused = false;
    try {
      userPaused = localStorage.getItem('hero-motion') === 'off';
    } catch {}

    const running = () => raf !== 0;

    const start = () => {
      if (!running() && inView && !userPaused) {
        raf = requestAnimationFrame(step);
        canvas.classList.add('is-running');
      }
    };

    const stop = () => {
      if (running()) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    const paint = () => {
      toggle.setAttribute('aria-pressed', String(userPaused));
      const label = toggle.querySelector('.label');
      if (label) label.textContent = userPaused ? 'Play motion' : 'Pause motion';
      canvas.classList.toggle('is-running', !userPaused);
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      try {
        localStorage.setItem('hero-motion', userPaused ? 'off' : 'on');
      } catch {}
      if (userPaused) stop();
      else start();
      paint();
    });

    band.addEventListener('pointermove', (e) => {
      const rect = band.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
    });
    band.addEventListener('pointerleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });

    // Tap/click the band to send out a beacon ripple — skip taps on
    // interactive children so links, buttons, and inputs stay clickable.
    band.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button, input')) return;
      const rect = band.getBoundingClientRect();
      ripples.push({
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
        r: 0,
        alpha: 1,
      });
      if (ripples.length > 6) ripples.shift();
    });

    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      },
      { threshold: 0.05 }
    );
    io.observe(band);

    window.addEventListener('resize', resize);
    resize();
    paint();
    start();

    cleanup = () => {
      stop();
      io.disconnect();
      window.removeEventListener('resize', resize);
    };
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
