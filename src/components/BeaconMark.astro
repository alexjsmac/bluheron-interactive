---
/**
 * The beacbeac ripple mark — a canonical, reusable version of the concentric
 * "beacon" glyph used on the homepage flagship card, the work index, and the
 * beacbeac page hero. Slowly broadcasting rings are a progressive
 * enhancement; reduced motion keeps the static mark.
 */
interface Props {
  size?: number;
}

const { size = 200 } = Astro.props;
---

<svg
  class="beacon-mark"
  width={size}
  height={size}
  viewBox="0 0 260 260"
  fill="none"
  aria-hidden="true"
>
  <circle cx="130" cy="130" r="12" fill="var(--cyan)"></circle>
  <circle class="ring-1" cx="130" cy="130" r="52" stroke="var(--cyan)" stroke-width="1.5" opacity="0.75"></circle>
  <circle class="ring-2" cx="130" cy="130" r="92" stroke="var(--cyan-deep)" stroke-width="1.25" opacity="0.45"></circle>
  <circle class="ring-3" cx="130" cy="130" r="126" stroke="var(--clay)" stroke-width="1" opacity="0.25"></circle>
  <circle cx="216" cy="80" r="5" fill="var(--clay)" opacity="0.9"></circle>
  <circle cx="52" cy="180" r="4" fill="var(--cyan-deep)" opacity="0.8"></circle>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ring-1,
    .ring-2,
    .ring-3 {
      transform-box: fill-box;
      transform-origin: center;
      animation-duration: 8s;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    .ring-1 {
      animation-name: broadcast-1;
      animation-delay: 0s;
    }

    .ring-2 {
      animation-name: broadcast-2;
      animation-delay: 1.2s;
    }

    .ring-3 {
      animation-name: broadcast-3;
      animation-delay: 2.4s;
    }
  }

  @keyframes broadcast-1 {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.75;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.4;
    }
  }

  @keyframes broadcast-2 {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.45;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.2;
    }
  }

  @keyframes broadcast-3 {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.25;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.08;
    }
  }
</style>
