---
// Click-to-load video facade: ships a poster image instead of an iframe, so
// case-study pages don't pay a player's weight until someone asks for it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  /** Full Vimeo URL, or a YouTube video id via `youtube`. */
  vimeo?: string;
  youtube?: string;
  poster: ImageMetadata;
  posterAlt: string;
  title: string;
}

const { vimeo, youtube, poster, posterAlt, title } = Astro.props;

const provider = youtube ? 'youtube' : 'vimeo';
const id = youtube ?? vimeo!.replace(/\/+$/, '').split('/').pop()!;
const watchUrl = youtube ? `https://www.youtube.com/watch?v=${youtube}` : vimeo!;
const providerName = youtube ? 'YouTube' : 'Vimeo';
---

<div class="video-facade" data-video-id={id} data-provider={provider} data-title={title}>
  <button type="button" class="facade-btn">
    <Image src={poster} alt={posterAlt} width={1280} widths={[768, 1280]} sizes="100vw" />
    <span class="scrim" aria-hidden="true"></span>
    <span class="play" aria-hidden="true">
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
        <circle cx="36" cy="36" r="36" fill="var(--cyan)"></circle>
        <path d="M29 22 L52 36 L29 50 Z" fill="#06131a"></path>
      </svg>
    </span>
    <span class="label">Play film &mdash; {title}</span>
  </button>
  <noscript>
    <a href={watchUrl} rel="noopener">Watch on {providerName}</a>
  </noscript>
</div>

<style>
  .video-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
  }

  .facade-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    margin: 0;
    background: none;
    cursor: pointer;
  }

  .facade-btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(6, 19, 26, 0.35);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .play {
      transition: transform 0.25s ease;
    }

    .facade-btn:hover .play,
    .facade-btn:focus-visible .play {
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  .label {
    position: absolute;
    bottom: 20px;
    left: 24px;
    color: #fff;
    font-weight: 500;
    font-size: 0.95rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .video-facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  noscript a {
    display: block;
    padding: 16px;
    text-align: center;
  }
</style>

<script>
  function initVideoFacades() {
    document.querySelectorAll<HTMLButtonElement>('.facade-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', () => {
        const wrapper = btn.closest<HTMLElement>('.video-facade');
        if (!wrapper) return;
        const id = wrapper.dataset.videoId;
        const provider = wrapper.dataset.provider;
        const title = wrapper.dataset.title ?? '';
        if (!id) return;

        const iframe = document.createElement('iframe');
        iframe.src =
          provider === 'youtube'
            ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
            : `https://player.vimeo.com/video/${id}?autoplay=1`;
        iframe.title = title;
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.allowFullscreen = true;

        btn.replaceWith(iframe);
      });
    });
  }

  initVideoFacades();
  document.addEventListener('astro:page-load', initVideoFacades);
</script>
