---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import heronMark from '../assets/brand/heron-mark.png';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="row">
      <div class="identity">
        <a class="wordmark" href={withBase('/')}>
          <Image class="mark" src={heronMark} alt="" width={64} densities={[1, 2]} />
          <span>BluHeron Interactive</span>
        </a>
        <p class="where">London &amp; Hamilton, ON</p>
      </div>
      <nav aria-label="Footer">
        <ul class="links">
          <li><a href={withBase('/contact/')}>Contact</a></li>
          <li>
            <a href="https://www.instagram.com/bluheroninteractive" rel="noopener">Instagram</a>
          </li>
          <li><a href={withBase('/news/')}>News</a></li>
          <li><a href={withBase('/accessibility/')}>Accessibility statement</a></li>
        </ul>
      </nav>
    </div>
    <p class="small">&copy; {year} BluHeron Interactive</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 48px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
    flex-wrap: wrap;
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark :global(.mark) {
    width: auto;
    height: 32px;
  }

  .where {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    gap: 12px 28px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .small {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .row {
      gap: 22px;
    }

    .links {
      gap: 12px 22px;
    }
  }
</style>
