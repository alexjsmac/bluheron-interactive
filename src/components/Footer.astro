---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import heronMark from '../assets/brand/heron-mark.png';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="row">
      <a class="wordmark" href={withBase('/')}>
        <Image class="mark" src={heronMark} alt="" width={64} densities={[1, 2]} />
        <span>BluHeron Interactive</span>
      </a>
      <ul class="meta">
        <li>London &amp; Hamilton, ON</li>
        <li><a href="tel:+19057304008">905-730-4008</a></li>
        <li><a href="mailto:alex@bluheroninteractive.com">alex@bluheroninteractive.com</a></li>
        <li>
          <a href="https://www.instagram.com/bluheroninteractive" rel="noopener">Instagram</a>
        </li>
      </ul>
    </div>
    <p class="land">
      We live and work on the traditional territories of the Haudenosaunee, Wendat, Anishinaabe,
      and Mississaugas of the Credit First Nation, and we serve communities across Turtle Island.
    </p>
    <div class="row small">
      <span>&copy; {year} BluHeron Interactive</span>
      <ul class="meta">
        <li><a href={withBase('/accessibility/')}>Accessibility statement</a></li>
        <li><a href={withBase('/news/')}>News</a></li>
        <li><a href={withBase('/contact/')}>Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 0;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-block: 48px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark :global(.mark) {
    width: auto;
    height: 32px;
  }

  .meta {
    display: flex;
    gap: 12px 28px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .land {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 66ch;
  }

  .small {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
