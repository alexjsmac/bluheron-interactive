---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import heronMark from '../assets/brand/heron-mark.png';

const current = Astro.url.pathname;

const links = [
  { n: '01', label: 'Work', href: '/work/' },
  { n: '02', label: 'beacbeac', href: '/beacbeac/' },
  { n: '03', label: 'Services', href: '/services/' },
  { n: '04', label: 'About', href: '/about/' },
  { n: '05', label: 'Values', href: '/values/' },
];

const isCurrent = (href: string) =>
  href === '/' ? current === withBase('/') : current.startsWith(withBase(href));
---

<header class="site-header">
  <nav class="wrap bar" aria-label="Main">
    <a class="wordmark" href={withBase('/')}>
      <Image class="mark" src={heronMark} alt="" width={80} densities={[1, 2]} />
      <span>BluHeron Interactive</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg
        class="icon-open"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7 H20 M4 12 H20 M4 17 H20"></path>
      </svg>
      <svg
        class="icon-close"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6 L18 18 M18 6 L6 18"></path>
      </svg>
      Menu
    </button>
    <ul class="links" id="site-nav">
      {
        links.map((l) => (
          <li>
            <a href={withBase(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              <span class="n" aria-hidden="true">
                {l.n}
              </span>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="btn hello" href={withBase('/contact/')}>Say hello</a>
      </li>
      <li>
        <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Toggle dark theme">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M21 12.8 A9 9 0 1 1 11.2 3 A7 7 0 0 0 21 12.8 Z"></path>
          </svg>
          <span class="toggle-label">Dark theme</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--paper);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 22px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: inherit;
    text-decoration: none;
  }

  .wordmark :global(.mark) {
    width: auto;
    height: 40px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .links a:not(.hello) {
    color: inherit;
    text-decoration: none;
    padding: 10px 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .links a:not(.hello) {
      font-variation-settings: 'wght' 400;
      will-change: font-variation-settings;
      transition: font-variation-settings 0.3s ease;
    }

    .links a:not(.hello):hover,
    .links a:not(.hello):focus-visible {
      font-variation-settings: 'wght' 640;
    }
  }

  .links a[aria-current='page'] {
    border-bottom: 2px solid var(--cyan);
  }

  .links a:not(.hello):hover {
    color: var(--cyan-text);
  }

  .n {
    color: var(--cyan-text);
    margin-right: 4px;
  }

  .hello {
    padding: 10px 20px;
    font-size: 0.8125rem;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: inherit;
    font: inherit;
    padding: 8px 14px;
    cursor: pointer;
  }

  html.no-js .theme-toggle {
    display: none;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: inherit;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 10px 16px;
    min-height: 44px;
    cursor: pointer;
  }

  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (max-width: 720px) {
    /* One row: wordmark and a menu button. Everything else lives in the
       panel, which is normal flow below the bar — no overlay, no z-index. */
    .bar {
      padding-block: 12px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .wordmark {
      font-size: 1.05rem;
      gap: 10px;
    }

    .wordmark :global(.mark) {
      height: 32px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-top: 10px;
      padding-bottom: 6px;
      border-top: 1px solid var(--line);
      font-size: 0.8rem;
      letter-spacing: 0.12em;
    }

    .site-header.is-open .links {
      display: flex;
    }

    .links li {
      display: flex;
    }

    .links a:not(.hello) {
      width: 100%;
      padding: 15px 0;
      border-bottom: 1px solid var(--line);
    }

    .links a[aria-current='page'] {
      border-bottom: 1px solid var(--line);
      color: var(--cyan-text);
    }

    .n {
      display: none;
    }

    .hello {
      width: 100%;
      margin-top: 14px;
      padding: 15px 20px;
      text-align: center;
    }

    .theme-toggle {
      width: 100%;
      margin-top: 10px;
      justify-content: center;
      min-height: 44px;
    }

    /* The label earns its space back in the panel. */
    .theme-toggle .toggle-label {
      display: inline;
    }
  }

  /* Without JS the button can't do anything, so show the nav instead. */
  html.no-js .menu-toggle {
    display: none;
  }

  @media (max-width: 720px) {
    html.no-js .links {
      display: flex;
    }
  }
</style>

<script>
  // With the ClientRouter this script executes once per site visit, not per
  // page. Re-run the paint step on every navigation (the saved theme may have
  // just been re-applied to <html>), and guard the click binding against
  // being attached twice.
  function initThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (!btn) return;

    const root = document.documentElement;

    const isDark = () =>
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);

    const paint = () => {
      btn.setAttribute('aria-pressed', String(isDark()));
    };

    if (!btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        paint();
      });
    }

    paint();
  }

  // The Escape handler lives on document, so it's bound once for the whole
  // site visit rather than once per navigation.
  let escBound = false;

  function initMenu() {
    const header = document.querySelector<HTMLElement>('.site-header');
    const btn = header?.querySelector<HTMLButtonElement>('.menu-toggle');
    if (!header || !btn) return;

    const close = () => {
      header.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    };

    if (!btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const open = header.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    }

    if (!escBound) {
      escBound = true;
      document.addEventListener('keydown', (e) => {
        const h = document.querySelector<HTMLElement>('.site-header');
        if (e.key !== 'Escape' || !h?.classList.contains('is-open')) return;
        h.classList.remove('is-open');
        const b = h.querySelector<HTMLButtonElement>('.menu-toggle');
        b?.setAttribute('aria-expanded', 'false');
        b?.focus();
      });
    }

    // Every navigation lands with the menu shut.
    close();
  }

  initThemeToggle();
  initMenu();
  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
    initMenu();
  });
</script>
