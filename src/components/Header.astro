---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import heronMark from '../assets/brand/heron-mark.png';

const current = Astro.url.pathname;

const links = [
  { n: '01', label: 'Work', href: '/work/' },
  { n: '02', label: 'beacbeac', href: '/beacbeac/' },
  { n: '03', label: 'Services', href: '/services/' },
  { n: '04', label: 'About', href: '/about/' },
  { n: '05', label: 'Values', href: '/values/' },
];

const isCurrent = (href: string) =>
  href === '/' ? current === withBase('/') : current.startsWith(withBase(href));
---

<header class="site-header">
  <nav class="wrap bar" aria-label="Main">
    <a class="wordmark" href={withBase('/')}>
      <Image class="mark" src={heronMark} alt="" width={80} densities={[1, 2]} />
      <span>BluHeron Interactive</span>
    </a>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={withBase(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              <span class="n" aria-hidden="true">
                {l.n}
              </span>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="btn hello" href={withBase('/contact/')}>Say hello</a>
      </li>
      <li>
        <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Toggle dark theme">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M21 12.8 A9 9 0 1 1 11.2 3 A7 7 0 0 0 21 12.8 Z"></path>
          </svg>
          <span class="toggle-label">Dark theme</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--paper);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 22px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: inherit;
    text-decoration: none;
  }

  .wordmark :global(.mark) {
    width: auto;
    height: 40px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .links a:not(.hello) {
    color: inherit;
    text-decoration: none;
    padding: 10px 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .links a:not(.hello) {
      font-variation-settings: 'wght' 400;
      will-change: font-variation-settings;
      transition: font-variation-settings 0.3s ease;
    }

    .links a:not(.hello):hover,
    .links a:not(.hello):focus-visible {
      font-variation-settings: 'wght' 640;
    }
  }

  .links a[aria-current='page'] {
    border-bottom: 2px solid var(--cyan);
  }

  .links a:not(.hello):hover {
    color: var(--cyan-text);
  }

  .n {
    color: var(--cyan-text);
    margin-right: 4px;
  }

  .hello {
    padding: 10px 20px;
    font-size: 0.8125rem;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: inherit;
    font: inherit;
    padding: 8px 14px;
    cursor: pointer;
  }

  html.no-js .theme-toggle {
    display: none;
  }

  @media (max-width: 720px) {
    .bar {
      padding-block: 14px;
      gap: 12px;
    }

    .wordmark {
      font-size: 1.1rem;
    }

    .links {
      font-size: 0.68rem;
      gap: 14px;
      letter-spacing: 0.1em;
    }

    .n {
      display: none;
    }

    .hello {
      padding: 8px 14px;
    }

    .theme-toggle {
      padding: 8px 10px;
    }

    .theme-toggle .toggle-label {
      display: none;
    }
  }
</style>

<script>
  // The header is transition:persist'ed across ClientRouter navigations, so
  // this script only executes once per site visit. Re-run the paint step on
  // every navigation (the saved theme may have just been re-applied to
  // <html>), and guard the click binding so it's never attached twice.
  function initThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (!btn) return;

    const root = document.documentElement;

    const isDark = () =>
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);

    const paint = () => {
      btn.setAttribute('aria-pressed', String(isDark()));
    };

    if (!btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        paint();
      });
    }

    paint();
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
