---
import { withBase } from '../lib/url';
interface Props {
  heading?: string;
}

const { heading = 'Let’s build something <em>everyone</em> can enter.' } = Astro.props;
---

<section class="band cta">
  <div class="wrap inner reveal">
    <h2 set:html={heading} />
    <a class="btn" href={withBase('/contact/')}>Start a conversation</a>
  </div>
</section>

<style>
  .cta {
    background-image: radial-gradient(
      ellipse 700px 300px at 50% 100%,
      rgba(0, 151, 178, 0.18),
      transparent 70%
    );
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-block: clamp(64px, 8vw, 96px);
    text-align: center;
  }

  h2 {
    font-weight: 400;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    max-width: 20ch;
  }
</style>
