---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

// The specific work we want more of under pillar 01, each tied to a project
// that shows it. Naming them lets a visitor recognise their own need, rather
// than decode "immersive experiences". Keep to work we're actively seeking.
const offerings = [
  {
    title: 'Public art for municipalities',
    text: 'Interactive and kinetic public art, from commission and community input through fabrication, installation, and upkeep.',
    example: { label: 'Navitas', slug: 'navitas' },
  },
  {
    title: 'Festival projection & live AV',
    text: 'Projection mapping, light installations, and live audiovisual performance for light, music, and arts festivals.',
    example: { label: 'Concrete Canopy', slug: 'concrete-canopy' },
  },
  {
    title: 'Museum & science-centre interactives',
    text: 'Hands-on exhibits that turn a collection or an idea into something visitors can play with, built to the same access standard as beacbeac.',
    example: { label: 'Blue Noise', slug: 'blue-noise' },
  },
  {
    title: 'Community engagement through art',
    text: 'Arts-based public consultation that people actually show up for, with results your department can use.',
    example: { label: 'Jump Around', slug: 'jump-around' },
  },
];
---

<Base
  title="Services — BluHeron Interactive"
  description="Three ways we work: immersive experiences and installations, the beacbeac accessibility platform, and digital services for arts organizations."
>
  <section class="wrap head">
    <p class="kicker">Services</p>
    <h1 class="display">Three ways we work.</h1>
    <p class="lede">
      Everything we do serves the same goal: art, places, and stories that more people can
      enter. Here's how that shows up in practice.
    </p>
  </section>

  <section class="wrap list">
    <article class="service reveal">
      <div class="head-row">
        <span class="num" aria-hidden="true">01</span>
        <h2>Immersive experiences &amp; installations</h2>
      </div>
      <p>
        Interactive projection, generative soundscapes, kinetic sculpture, augmented reality,
        and live performance — designed for streets, parks, galleries, and festivals. We
        co-create with the communities each piece is built for, using arts-based methods for
        public engagement and feedback: the artwork is also the conversation.
      </p>
      <ul class="offerings" role="list">
        {
          offerings.map((o) => (
            <li>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
              <a class="example" href={withBase(`/work/${o.example.slug}/`)}>
                See {o.example.label} &rarr;
              </a>
            </li>
          ))
        }
      </ul>
      <p class="for">
        For municipalities, festivals, museums, science centres, and community organizations.{' '}
        <a href={withBase('/work/')}>See all the work &rarr;</a>
      </p>
    </article>

    <article class="service reveal">
      <div class="head-row">
        <span class="num" aria-hidden="true">02</span>
        <h2>beacbeac deployments</h2>
      </div>
      <p>
        beacbeac, a disability-led program owned and led by Centre[4]Arts that we develop and
        operate, brings accessible, place-based stories to visitors' own phones — no QR codes,
        nothing to hunt for. We handle site surveys, beacon installation, content
        loading, staff orientation, and on-site support through your event, then hand you the
        engagement analytics. Or run it yourself: the console is built for the team you have.
      </p>
      <p class="for">
        For festivals, museums, trails, main streets, and public spaces.{' '}
        <a href={withBase('/beacbeac/')}>Meet beacbeac &rarr;</a>
      </p>
    </article>

    <article class="service reveal">
      <div class="head-row">
        <span class="num" aria-hidden="true">03</span>
        <h2>Digital services for arts organizations</h2>
      </div>
      <p>
        Websites, hosting, maintenance, and accessibility audits — for arts councils,
        galleries, studios, and festivals. We stay inside the arts community on purpose:
        that's where we can help the most, and it keeps every project connected to the same
        mission. Accessibility audits come with real reports, not checkbox exercises.
      </p>
      <p class="for">
        For arts councils and arts organizations across Ontario.{' '}
        <a href={withBase('/contact/')}>Ask about your site &rarr;</a>
      </p>
    </article>
  </section>

  <ContactCTA heading="Not sure which one you need? <em>Ask.</em>" />
</Base>

<style>
  .head {
    padding-block: clamp(48px, 7vw, 80px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .list {
    padding-block: clamp(24px, 4vw, 40px) clamp(56px, 8vw, 88px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 64px);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-top: 1px solid var(--line);
    padding-top: clamp(32px, 5vw, 48px);
    max-width: 800px;
  }

  .head-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--cyan-text);
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .service p {
    color: var(--ink-2);
    line-height: 1.75;
  }

  .offerings {
    list-style: none;
    margin: 8px 0 4px;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px 40px;
  }

  @media (min-width: 640px) {
    .offerings {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .offerings li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 2px solid var(--mist-line);
    padding-left: 18px;
  }

  .offerings h3 {
    font-size: 1.15rem;
  }

  .offerings p {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .example {
    font-size: 0.9rem;
    align-self: flex-start;
  }

  /* Keep "See … →" links whole so the arrow never wraps onto its own line. */
  .for a {
    white-space: nowrap;
  }

  .for {
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>
