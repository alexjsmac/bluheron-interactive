---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';
import BeaconMark from '../components/BeaconMark.astro';
import blueNoiseWhale from '../assets/work/blue-noise-whale.png';
import navitasSculpture from '../assets/work/navitas-sculpture.jpg';
import navitasArtcrawl from '../assets/work/navitas-artcrawl.jpg';
import jumpAround from '../assets/work/jump-around.png';

const rs = [
  {
    name: 'Respect',
    text: 'Our door is open to every body and bandwidth. It shapes how we design — and how this website is built: readable without JavaScript, honest about motion, tested with screen readers.',
    link: { href: '/accessibility/', label: 'Our accessibility statement' },
    img: null,
    alt: '',
  },
  {
    name: 'Relevance',
    text: 'Work grows from the place it lives in. Blue Noise speaks to an ocean coalition; Navitas to a city and its water. Nothing is parachuted in.',
    link: { href: '/work/blue-noise/', label: 'Blue Noise' },
    img: blueNoiseWhale,
    alt: 'A projected whale swimming through luminous ocean visuals.',
  },
  {
    name: 'Responsibility',
    text: 'We build with reclaimed materials where we can, leave sites as we found them, and treat community stories as belonging to the communities that told them.',
    link: { href: '/work/navitas/', label: 'Navitas' },
    img: navitasSculpture,
    alt: 'The Navitas sculpture, built from copper, wood, and aluminum, glowing with blue LEDs.',
  },
  {
    name: 'Reciprocity',
    text: 'Advisors join at the start of each project, not the end — and engagement flows both ways: every activation gathers community feedback and gives something back.',
    link: { href: '/about/', label: 'Our advisors' },
    img: navitasArtcrawl,
    alt: 'Visitors gathered around the Navitas sculpture at an evening art crawl.',
  },
  {
    name: 'Relationality',
    text: 'Partnership, co-creation, and just having fun together. The connections a project sparks matter more than the hardware it runs on.',
    link: { href: '/work/', label: 'The work it leads to' },
    img: jumpAround,
    alt: 'A crowd dancing under colourful lights at Jump Around.',
  },
];
---

<Base
  title="Values — BluHeron Interactive"
  description="The 5 Rs — Respect, Relevance, Responsibility, Reciprocity, Relationality — and how they show up in every BluHeron Interactive project."
>
  <section class="wrap head">
    <p class="kicker">Values</p>
    <h1 class="display">The <em class="clay">5 Rs</em> we create by.</h1>
    <p class="lede">
      Our blend of arts-based research for public engagement focuses on a principles-based
      approach where honesty, respect, equality, fairness, and courage are our guides. We work
      to provide supportive time and space for diverse, equity-seeking people to feel empowered
      to engage. Together, we create through lived experiences following the 5 Rs.
    </p>
  </section>

  <section class="wrap list stagger">
    {
      rs.map((r) => (
        <article class="r reveal">
          {r.img ? (
            <Image
              class="visual"
              src={r.img}
              alt={r.alt}
              width={640}
              widths={[400, 640]}
              sizes="(max-width: 720px) 100vw, 33vw"
            />
          ) : (
            <div class="visual mark">
              <BeaconMark size={120} />
            </div>
          )}
          <h2>{r.name}</h2>
          <p>{r.text}</p>
          <a href={withBase(r.link.href)}>{r.link.label} &rarr;</a>
        </article>
      ))
    }
  </section>

  <section class="band decolonize">
    <div class="wrap inner">
      <h2>Many voices, from the start.</h2>
      <p>
        Focusing on decolonizing, diversity, and inclusivity requires many voices and
        perspectives to be embedded in the activations we develop and deliver. We commit to
        including our advisors from the start of each project, with check-ins throughout — not
        as a review at the end.
      </p>
      <a class="arrow-link" href={withBase('/about/')}>Meet our advisors &rarr;</a>
    </div>
  </section>

  <ContactCTA heading="Share your community's <em>story</em> with us." />
</Base>

<style>
  .head {
    padding-block: clamp(48px, 7vw, 80px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .head em.clay {
    color: var(--clay);
  }

  .lede {
    font-size: 1.05rem;
    color: var(--ink-2);
    line-height: 1.75;
    max-width: 64ch;
  }

  .list {
    padding-block: clamp(24px, 4vw, 40px) clamp(56px, 8vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .r {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .visual {
    width: 100%;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    object-fit: cover;
  }

  .visual.mark {
    background: var(--band);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .r h2 {
    font-size: 1.9rem;
  }

  .r p {
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .r a {
    font-size: 0.9rem;
  }

  .decolonize .inner {
    padding-block: clamp(56px, 8vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .decolonize h2 {
    font-weight: 400;
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
  }

  .decolonize p {
    color: var(--band-ink-2);
    max-width: 62ch;
    line-height: 1.75;
  }
</style>
