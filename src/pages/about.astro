---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';
import chrisPhoto from '../assets/team/chris-mcleod.jpg';
import alexPhoto from '../assets/team/alex-maclean.jpg';
---

<Base
  title="About — BluHeron Interactive"
  description="BluHeron Interactive is a small studio in London & Hamilton, Ontario — two artists who design, build, and run immersive work with the communities it is made for."
>
  <section class="wrap head">
    <p class="kicker">About us</p>
    <h1 class="display">We design it, we build it, and we're <em class="clay">there when it runs</em>.</h1>
  </section>

  <section class="wrap story">
    <p>
      BluHeron Interactive is a small studio in London and Hamilton, Ontario. We're both
      artists and we both art-direct — Chris from three decades of community-engaged public
      art, Alex from immersive media and code. Between us we've put interactive work in
      galleries, market squares, sculpture gardens, a landfill, and the middle of a street
      festival, and we're usually the ones on site before the doors open making sure it still
      works.
    </p>
    <p>
      That's the point of a studio this size. We're not a design shop that hands off a
      concept, and we're not a development shop waiting for a brief. The people who build the
      work are in the room when it's designed — which is why it tends to survive contact with
      real weather, real crowds, and real budgets.
    </p>
  </section>

  <section class="band now">
    <div class="wrap inner">
      <p class="kicker">What we're working on now</p>
      <p class="now-lede">
        This fall, <a href={withBase('/beacbeac/')}>beacbeac</a> — our platform for accessible,
        place-based stories — goes out at Ability First Fest and Supercrawl in Hamilton, and
        Nuit Blanche London. We're a business member of the Canadian Museums Association, and
        we keep the websites and hosting running for arts organizations including Centre[4]Arts
        and the Mississauga Arts Council.
      </p>
    </div>
  </section>

  <section class="wrap principles">
    <h2>How we work</h2>
    <div class="grid stagger">
      <article class="principle reveal">
        <h3>Co-creation, not consultation</h3>
        <p>
          <a href={withBase('/work/navitas/')}>Navitas</a> needed two people pumping together
          to move water across Hamilton.{' '}
          <a href={withBase('/work/jump-around/')}>Jump Around</a> put the audience inside the
          game show. The participation is the artwork, not a survey bolted onto one.
        </p>
      </article>
      <article class="principle reveal">
        <h3>Access designed in, not added on</h3>
        <p>
          beacbeac was co-designed with Blind, Low Vision, Deaf, Deafblind, and disabled
          community members. That was the starting condition, not a retrofit.
        </p>
      </article>
      <article class="principle reveal">
        <h3>Build with what's already there</h3>
        <p>
          Navitas is 2,000 LEDs threaded through reclaimed copper, aluminum, and wood. The{' '}
          <a href={withBase('/work/landfill-education-model/')}>Landfill Education Model</a>{' '}
          explains a system most people never get to see.
        </p>
      </article>
      <article class="principle reveal">
        <h3>We stay in the arts on purpose</h3>
        <p>
          We take websites and hosting for arts councils, galleries, and festivals — not
          because we want to be a web shop, but because it's the same community, and it's
          where we're most useful.
        </p>
      </article>
    </div>
  </section>

  <section class="wrap team">
    <h2>Our team</h2>
    <div class="people">
      <article class="person reveal">
        <Image src={chrisPhoto} alt="Portrait of Christopher McLeod" width={600} widths={[300, 600]} sizes="(max-width: 720px) 100vw, 300px" />
        <h3>Christopher McLeod</h3>
        <p class="role">Co-founder &middot; Artistic director</p>
        <p>
          A freelance artist and artistic director for three decades, Chris has led 24
          community-engaged public art projects across Ontario, with a BA in Studio Art from
          McMaster and an MFA from Emily Carr University focused on social practice and
          community interaction. His work has always been about creating opportunities for
          people to connect in positive and meaningful ways — art just sort of happened along
          the way.
        </p>
        <p class="land">
          Chris is of settler ancestry, living on the traditional territory of the
          Haudenosaunee, Wendat, and Mississaugas of the Credit First Nation.
        </p>
      </article>
      <article class="person reveal">
        <Image src={alexPhoto} alt="Portrait of Alex MacLean" width={600} widths={[300, 600]} sizes="(max-width: 720px) 100vw, 300px" />
        <h3>Alex MacLean</h3>
        <p class="role">Co-founder &middot; Artist &amp; creative technologist</p>
        <p>
          An immersive media artist and developer, Alex art-directs and builds — from
          generative audiovisual installations like{' '}
          <a href={withBase('/work/blue-noise/')}>Blue Noise</a> and{' '}
          <a href={withBase('/work/concrete-canopy/')}>Concrete Canopy</a> to the beacbeac
          platform, its apps and admin console, and the websites we look after for arts
          organizations. Sound, light, and code: experiences that listen back.
        </p>
        <p class="land">
          <a href="https://alexmaclean.ca" rel="noopener">alexmaclean.ca &rarr;</a>
        </p>
      </article>
    </div>
  </section>

  <ContactCTA heading="New partners, collaborators &amp; friends — <em>let’s talk</em>." />
</Base>

<style>
  .head {
    padding-block: clamp(48px, 7vw, 80px) clamp(24px, 4vw, 36px);
  }

  .head em.clay {
    color: var(--clay);
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: clamp(48px, 7vw, 72px);
  }

  .story p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 66ch;
  }

  .now .inner {
    padding-block: clamp(48px, 7vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .now-lede {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 70ch;
  }

  .principles {
    padding-block: clamp(56px, 8vw, 88px) clamp(40px, 6vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .principles h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
  }

  .principles .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(32px, 4vw, 48px);
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }

  .principle h3 {
    font-size: 1.25rem;
  }

  .principle p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .team {
    padding-block: 0 clamp(56px, 8vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .team h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 5vw, 56px);
  }

  .person {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .person img {
    width: min(300px, 100%);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
  }

  .person h3 {
    font-size: 1.6rem;
    margin-top: 10px;
  }

  .role {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .person p:not(.role) {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .person .land {
    font-size: 0.9rem;
    color: var(--muted);
  }

</style>
