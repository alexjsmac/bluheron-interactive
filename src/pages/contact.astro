---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';

const FORMSPREE_ID = 'xeaqqbob';
const FORM_ACTION = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<Base
  title="Contact — BluHeron Interactive"
  description="Start a conversation with BluHeron Interactive — immersive experiences, beacbeac deployments, and digital services for arts organizations. London & Hamilton, Ontario."
>
  <section class="wrap head">
    <p class="kicker">Contact</p>
    <h1 class="display">Say <em class="clay">hello</em>.</h1>
    <p class="lede">
      New project partners, collaborators, and friends — we'd love to hear what you're
      dreaming up. No idea is too early.
    </p>
  </section>

  <section class="wrap body">
    <div class="direct">
      <div>
        <p class="label">Email</p>
        <p><a href="mailto:info@bluheroninteractive.com">info@bluheroninteractive.com</a></p>
      </div>
      <div>
        <p class="label">Instagram</p>
        <p>
          <a href="https://www.instagram.com/bluheroninteractive" rel="noopener">
            @bluheroninteractive
          </a>
        </p>
      </div>
      <div>
        <p class="label">Where</p>
        <p>London &amp; Hamilton, Ontario — working across Ontario and beyond.</p>
      </div>
    </div>

    <div class="form-area">
      {/* Posts natively without JavaScript; the script below upgrades it to
          submit in place so nobody loses the page they were on. */}
      <form class="contact-form" method="POST" action={FORM_ACTION} data-endpoint={FORM_ACTION}>
        <p class="form-error" data-form-error hidden role="alert" tabindex="-1"></p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <p class="field-error" id="name-error" data-field-error="name" hidden></p>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="field-error" id="email-error" data-field-error="email" hidden></p>
        </div>

        <div class="field">
          <label for="message">What are you dreaming up?</label>
          <textarea id="message" name="message" rows="6" required></textarea>
          <p class="field-error" id="message-error" data-field-error="message" hidden></p>
        </div>

        <input type="hidden" name="_subject" value="New enquiry from bluheroninteractive.com" />

        {/* Spam trap: hidden from people and assistive tech, catnip for bots. */}
        <div class="gotcha" aria-hidden="true">
          <label for="_gotcha">Leave this field empty</label>
          <input id="_gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn" type="submit">Send it</button>
      </form>

      <div class="form-success" data-form-success hidden tabindex="-1" role="status">
        <h2>Thanks — that's with us.</h2>
        <p>
          We read everything ourselves and usually reply within a couple of days. If it's
          urgent, email <a href="mailto:info@bluheroninteractive.com">info@bluheroninteractive.com</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(48px, 7vw, 80px) clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .head em.clay {
    color: var(--clay);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .body {
    display: flex;
    gap: clamp(40px, 6vw, 80px);
    flex-wrap: wrap;
    align-items: flex-start;
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .direct {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: var(--paper-2);
    border-radius: 16px;
    padding: 36px;
    min-width: 280px;
    flex: 1;
  }

  .label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 4px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-weight: 500;
    font-size: 0.95rem;
  }

  input,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
    border-color: var(--cyan);
  }

  .contact-form .btn {
    align-self: flex-start;
  }

  .contact-form .btn[disabled] {
    opacity: 0.65;
    cursor: progress;
  }

  .form-area {
    flex: 2;
    min-width: 300px;
  }

  .form-area .contact-form {
    width: 100%;
  }

  .field-error,
  .form-error {
    font-size: 0.9rem;
    color: var(--clay);
    font-weight: 500;
  }

  .form-error {
    border-left: 3px solid var(--clay);
    padding-left: 12px;
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--clay);
  }

  /* Off-screen rather than display:none — bots fill what they can see in the
     DOM, and people never reach it. */
  .gotcha {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form-success {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--mist);
    border: 1px solid var(--mist-line);
    border-radius: 16px;
    padding: 32px;
  }

  .form-success h2 {
    font-size: 1.6rem;
  }

  .form-success p {
    color: var(--ink-2);
  }

  /* These carry an explicit display, which would otherwise beat the [hidden]
     attribute's own display:none. */
  .contact-form[hidden],
  .form-success[hidden],
  .field-error[hidden],
  .form-error[hidden] {
    display: none;
  }

  /* The panel takes focus so keyboard and screen-reader users land on the
     confirmation — but it is a status message, not a control, so it does not
     need a focus ring. Safari paints one by default; this removes it. */
  .form-success:focus {
    outline: none;
  }
</style>

<script>
  // The form posts natively without JavaScript. This upgrades it to submit in
  // place, so a visitor keeps their scroll position and gets errors inline.
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('.contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    const endpoint = form.dataset.endpoint;
    const success = document.querySelector<HTMLElement>('[data-form-success]');
    const formError = form.querySelector<HTMLElement>('[data-form-error]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!endpoint || !success || !formError || !button) return;

    const clearErrors = () => {
      formError.hidden = true;
      formError.textContent = '';
      form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      form.querySelectorAll<HTMLElement>('input, textarea').forEach((el) => {
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      });
    };

    const showFieldError = (field: string, message: string) => {
      const note = form.querySelector<HTMLElement>(`[data-field-error="${field}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
      if (!note || !input) return false;
      note.textContent = message;
      note.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', note.id);
      return true;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      button.disabled = true;
      const label = button.textContent;
      button.textContent = 'Sending…';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }

        const data = await res.json().catch(() => null);
        const errors = data?.errors ?? [];
        let firstInvalid: HTMLElement | null = null;

        for (const err of errors) {
          const field = err.field;
          if (field && showFieldError(field, err.message)) {
            firstInvalid ??= form.querySelector<HTMLElement>(`[name="${field}"]`);
          }
        }

        const unfielded = errors.filter((x: { field?: string }) => !x.field);
        if (!errors.length || unfielded.length) {
          formError.textContent = unfielded[0]?.message
            ? `That didn't send: ${unfielded[0].message}`
            : "That didn't send. Please try again, or email info@bluheroninteractive.com.";
          formError.hidden = false;
        }

        (firstInvalid ?? formError).focus?.();
      } catch {
        formError.textContent =
          "That didn't send — you may be offline. Please try again, or email info@bluheroninteractive.com.";
        formError.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
