---
import { withBase } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import PixelField from '../../components/PixelField.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import LogoRow from '../../components/LogoRow.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// Share card: the project's own hero, cropped to the 1.91:1 OG ratio.
const share = d.hero
  ? await getImage({ src: d.hero, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);

const clipPoster = d.video
  ? await getImage({ src: d.video.poster, width: d.video.vertical ? 720 : 1280, format: 'jpeg' })
  : undefined;
const paired = !!(d.quote && d.video?.vertical && clipPoster);

// Search: say what the project is in the title (the kicker's first part,
// e.g. "Interactive museum exhibition"), and keep the snippet short.
const kind = d.kicker.split(' · ')[0];
const pageTitle = `${d.title} — ${kind} | BluHeron Interactive`;
const pageDescription = d.description ?? d.summary;
// Town and province only: the venue is usually already in Occasion or
// Partner, so it goes to structured data but not on screen.
const place = d.location ? `${d.location.locality}, ${d.location.region}` : undefined;

// Structured data. Partners are contributors (several, split on " · "),
// funders come from `funders` plus any funder logos under `support`.
const org = (name: string) => ({ '@type': 'Organization', name });
const partners = d.partner ? d.partner.split(' · ') : [];
const funders = [...new Set([...d.funders, ...(d.support?.logos.map((l) => l.name) ?? [])])];
const abs = (path: string) => new URL(path, Astro.site).href;
const studio = {
  '@type': 'Organization',
  name: 'BluHeron Interactive',
  url: 'https://bluheroninteractive.com',
};
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  headline: d.tagline,
  description: d.summary,
  url: canonical.href,
  ...(share ? { image: abs(share.src) } : {}),
  creator: studio,
  ...(partners.length ? { contributor: partners.map(org) } : {}),
  ...(funders.length ? { funder: funders.map(org) } : {}),
  ...(d.location
    ? {
        locationCreated: {
          '@type': 'Place',
          ...(d.location.venue ? { name: d.location.venue } : {}),
          address: {
            '@type': 'PostalAddress',
            addressLocality: d.location.locality,
            addressRegion: d.location.region,
            addressCountry: d.location.country,
          },
        },
      }
    : {}),
  ...(d.year ? { dateCreated: String(d.year) } : {}),
  genre: kind,
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
};
const videoLd =
  d.video && clipPoster
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: `${d.title}: ${d.video.title}`,
        description: pageDescription,
        thumbnailUrl: abs(clipPoster.src),
        uploadDate: d.video.uploaded.toISOString().slice(0, 10),
        duration: `PT${d.video.seconds}S`,
        contentUrl: abs(withBase(d.video.src)),
        ...(d.video.creator ? { creator: org(d.video.creator) } : {}),
        ...(d.video.transcript ? { transcript: d.video.transcript } : {}),
        about: { '@type': 'CreativeWork', name: d.title, url: canonical.href },
      }
    : undefined;

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
---

<Base title={pageTitle} description={pageDescription} image={share?.src} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(workLd)} />
  {videoLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(videoLd)} />}
  <div class:list={['hero', { 'has-photo': !!d.hero }]}>
    {
      d.hero ? (
        <>
          <Image
            src={d.hero}
            alt={d.heroAlt ?? ''}
            width={1920}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            transition:name={`work-hero-${project.id}`}
          />
          <div class="scrim" aria-hidden="true" />
        </>
      ) : (
        <PixelField />
      )
    }
    <div class="wrap title-block">
      <p class:list={['kicker', { 'on-dark': !!d.hero }]}>Case study &middot; {d.kicker}</p>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
    </div>
  </div>

  <section class="wrap context">
    <div class="prose reveal">
      <h2 class="kicker">About the project</h2>
      <Content />
    </div>
    <aside class="meta" aria-label="Project details">
      {
        place && (
          <div>
            <p class="label">Where</p>
            <p>{place}</p>
          </div>
        )
      }
      {
        d.partner && (
          <div>
            <p class="label">Partner</p>
            <p>{d.partner}</p>
          </div>
        )
      }
      {
        d.occasion && (
          <div>
            <p class="label">Occasion</p>
            <p>{d.occasion}</p>
          </div>
        )
      }
      {
        d.medium && (
          <div>
            <p class="label">Medium</p>
            <p>{d.medium}</p>
          </div>
        )
      }
      {
        (d.vimeo || d.youtube) && (
          <div>
            <p class="label">Film</p>
            <p>
              <a
                href={d.youtube ? `https://www.youtube.com/watch?v=${d.youtube}` : d.vimeo}
                rel="noopener"
              >
                Watch on {d.youtube ? 'YouTube' : 'Vimeo'} &rarr;
              </a>
            </p>
          </div>
        )
      }
    </aside>
  </section>

  {/* A curator's quote and a phone-shot video pair up side by side: the
      video column is narrow, the quote fills the rest. Either one alone
      renders full width. */}
  <div class:list={paired ? 'wrap pair reveal' : 'unpaired'}>
    {
      d.quote && (
        <figure class:list={['quote', { 'wrap reveal': !paired }]}>
          <blockquote>
            <p>&ldquo;{d.quote.text}&rdquo;</p>
          </blockquote>
          <figcaption>
            <span class="who">{d.quote.name}</span>, {d.quote.role}
          </figcaption>
        </figure>
      )
    }
    {
      d.video && clipPoster && (
        <figure class:list={['clip', { vertical: d.video.vertical, 'wrap reveal': !paired }]}>
          <video
            src={withBase(d.video.src)}
            poster={clipPoster.src}
            controls
            playsinline
            preload="none"
            aria-label={`${d.video.title} — ${d.title}`}
          />
          <figcaption>
            <p class="kicker">Video</p>
            <p class="clip-title">{d.video.title}</p>
            {d.video.credit && <p class="clip-credit">{d.video.credit}</p>}
          {d.video.transcript && (
            <details class="transcript">
              <summary>Transcript</summary>
              <p>{d.video.transcript}</p>
            </details>
          )}
          </figcaption>
        </figure>
      )
    }
  </div>

  {
    (d.vimeo || d.youtube) && d.hero && (
      <section class="wrap film">
        <VideoFacade
          vimeo={d.vimeo}
          youtube={d.youtube}
          poster={d.hero}
          posterAlt={d.heroAlt ?? ''}
          title={d.title}
        />
      </section>
    )
  }

  {
    d.howItWorks.length > 0 && (
      <section class="band how">
        <div class="wrap inner">
          <h2 class="kicker">How it works</h2>
          <ol role="list" class="stagger">
            {d.howItWorks.map((step, i) => (
              <li class="reveal">
                <span class="num" aria-hidden="true">
                  {i + 1}
                </span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    d.gallery.length > 0 && (
      <section class="wrap gallery" aria-labelledby="photos-heading">
        <h2 id="photos-heading" class="sr-only">
          Photos
        </h2>
        {d.gallery.map((g) => (
          <Image
            src={g.src}
            alt={g.alt}
            width={1200}
            widths={[600, 1200]}
            sizes="(max-width: 720px) 100vw, 48vw"
          />
        ))}
      </section>
    )
  }

  {
    d.credits.length > 0 && (
      <section class="credits-band">
        <div class="wrap inner">
          <div class="credits">
            <h2 class="kicker">Credits</h2>
            <ul role="list">
              {d.credits.map((c) => (
                <li>
                  <span class="role">{c.role}</span> — {c.name}
                </li>
              ))}
            </ul>
            {d.support && (
              <div class="support">
                <p class="support-text">{d.support.text}</p>
                {d.support.logos.length > 0 && (
                  <LogoRow
                    items={d.support.logos.map((l) => ({ name: l.name, logo: l.src }))}
                    label="Funders"
                    scale={1.5}
                  />
                )}
              </div>
            )}
          </div>
          <p class="next">
            Next project: <a href={withBase(`/work/${next.id}/`)}>{next.data.title} &rarr;</a>
          </p>
        </div>
      </section>
    )
  }

  <ContactCTA heading="Bring this to your <em>community</em>." />
</Base>

<style>
  /* Photography treatment: this band stays dark regardless of theme —
     the image needs the scrim, and the scrim needs the dark ground. */
  .hero {
    position: relative;
    background-color: var(--mist);
    color: var(--ink);
    min-height: clamp(300px, 38vw, 400px);
    display: flex;
    align-items: flex-end;
  }

  /* The pixel field fades out under the title, so the copy sits on clean
     ground — the same quiet zone the home hero carves for its text. */
  .hero:not(.has-photo)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--mist) 0%,
      var(--mist) 26%,
      color-mix(in srgb, var(--mist) 82%, transparent) 46%,
      transparent 78%
    );
    pointer-events: none;
  }

  .title-block {
    z-index: 1;
  }

  /* Photography treatment: a photo hero stays dark regardless of theme —
     the image needs the scrim, and the scrim needs the dark ground. */
  .hero.has-photo {
    display: block;
    background-color: var(--band);
    color: var(--band-ink);
  }

  .hero img {
    width: 100%;
    height: clamp(360px, 55vw, 560px);
    object-fit: cover;
    opacity: 0.55;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      rgba(10, 16, 22, 0.8) 0%,
      rgba(10, 16, 22, 0.15) 40%,
      rgba(10, 16, 22, 0.92) 100%
    );
  }

  .title-block {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(44px, 6vw, 64px) clamp(32px, 5vw, 56px);
  }

  .has-photo .title-block {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding-block: 0 clamp(32px, 5vw, 56px);
  }

  h1 {
    font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    line-height: 1;
  }

  .tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    color: var(--cyan-text);
    max-width: 44ch;
  }

  .has-photo .tagline {
    color: var(--mint);
  }

  .context {
    display: flex;
    gap: clamp(40px, 6vw, 80px);
    align-items: flex-start;
    flex-wrap: wrap;
    padding-block: clamp(56px, 8vw, 88px);
  }

  .quote {
    margin-block: 0 clamp(56px, 8vw, 88px);
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-left: 3px solid var(--cyan);
    padding-left: clamp(20px, 3vw, 32px);
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .quote figcaption {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .quote .who {
    font-weight: 600;
    color: var(--ink);
  }

  .prose {
    flex: 2;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .prose :global(p) {
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.2em;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .meta {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--paper-2);
    border-radius: 16px;
    padding: 32px;
  }

  .label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 4px;
  }

  .meta p:not(.label) {
    font-weight: 500;
  }

  .film {
    padding-block: 0 clamp(40px, 6vw, 64px);
  }

  /* Self-hosted clip. Vertical (phone) video sits beside its caption on
     wide screens and stays phone-sized, never stretched to the column. */
  .clip {
    margin-block: 0 clamp(56px, 8vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .clip video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    background: var(--band);
  }

  .clip.vertical video {
    width: min(100%, 380px);
    aspect-ratio: 9 / 16;
  }

  @media (min-width: 720px) {
    .clip.vertical {
      flex-direction: row;
      align-items: flex-end;
      gap: clamp(28px, 4vw, 48px);
    }
  }

  .clip figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .clip-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.2;
  }

  .clip-credit {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  /* Collapsed by default so the player stays the focus; the text is in
     the HTML either way, for search and screen readers. */
  .transcript {
    margin-top: 10px;
    max-width: 360px;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .transcript summary {
    cursor: pointer;
    color: var(--link);
    width: fit-content;
  }

  .transcript p {
    margin-top: 8px;
    line-height: 1.6;
  }

  .unpaired {
    display: contents;
  }

  /* Quote + vertical video. Small screens: the quote reads first, then the
     video. Wide screens: the video takes a phone-width column on the left
     and the quote, set larger, centres against it on the right. */
  .pair {
    display: grid;
    gap: 40px;
    margin-block: 0 clamp(56px, 8vw, 88px);
  }

  .pair .quote,
  .pair .clip {
    margin: 0;
  }

  .pair .clip {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .pair .clip video {
    width: min(100%, 360px);
  }

  .pair .clip figcaption {
    gap: 2px;
  }

  .pair .clip .kicker {
    display: none;
  }

  .pair .clip-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
  }

  .pair .clip-credit {
    font-size: 0.85rem;
  }

  @media (min-width: 860px) {
    .pair {
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      align-items: center;
      gap: clamp(48px, 7vw, 112px);
    }

    .pair .clip {
      grid-column: 1;
      grid-row: 1;
    }

    .pair .quote {
      grid-column: 2;
      grid-row: 1;
      max-width: 640px;
    }

    .pair .quote blockquote p {
      font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    }
  }

  .how {
    background-image: radial-gradient(
      ellipse 600px 300px at 20% 0%,
      rgba(0, 151, 178, 0.07),
      transparent 70%
    );
  }

  .how .inner {
    padding-block: clamp(56px, 8vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .how ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 44px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .how li {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.8rem;
    color: var(--cyan);
  }

  .how h3 {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .how p {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    padding-block: clamp(56px, 8vw, 88px);
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }

  .credits-band {
    background: var(--paper-2);
  }

  .credits-band .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    padding-block: clamp(48px, 7vw, 72px);
  }

  .credits {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .credits ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .role {
    font-weight: 500;
    color: var(--ink);
  }

  .support {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    max-width: 640px;
  }

  .support-text {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  /* Funder marks render at full strength: pure black (or white in the dark
     theme), never the muted grey of the partner strip. Funders' guidelines
     allow only their own palette colours. */
  .support :global(.mark) {
    opacity: 1;
  }

  .next {
    font-size: 0.95rem;
  }
</style>
