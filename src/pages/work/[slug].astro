---
import { withBase } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import PixelField from '../../components/PixelField.astro';
import VideoFacade from '../../components/VideoFacade.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// Share card: the project's own hero, cropped to the 1.91:1 OG ratio.
const share = d.hero
  ? await getImage({ src: d.hero, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
---

<Base
  title={`${d.title} — BluHeron Interactive`}
  description={d.summary}
  image={share?.src}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: d.title,
      headline: d.tagline,
      description: d.summary,
      url: canonical.href,
      ...(share ? { image: new URL(share.src, Astro.site).href } : {}),
      creator: {
        '@type': 'Organization',
        name: 'BluHeron Interactive',
        url: 'https://bluheroninteractive.com',
      },
      ...(d.partner ? { sponsor: { '@type': 'Organization', name: d.partner } } : {}),
      ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
    })}
  />
  <div class:list={['hero', { 'has-photo': !!d.hero }]}>
    {
      d.hero ? (
        <>
          <Image
            src={d.hero}
            alt={d.heroAlt ?? ''}
            width={1920}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            transition:name={`work-hero-${project.id}`}
          />
          <div class="scrim" aria-hidden="true" />
        </>
      ) : (
        <PixelField />
      )
    }
    <div class="wrap title-block">
      <p class:list={['kicker', { 'on-dark': !!d.hero }]}>Case study &middot; {d.kicker}</p>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
    </div>
  </div>

  <section class="wrap context">
    <div class="prose reveal">
      <Content />
    </div>
    <aside class="meta" aria-label="Project details">
      {
        d.partner && (
          <div>
            <p class="label">Partner</p>
            <p>{d.partner}</p>
          </div>
        )
      }
      {
        d.occasion && (
          <div>
            <p class="label">Occasion</p>
            <p>{d.occasion}</p>
          </div>
        )
      }
      {
        d.medium && (
          <div>
            <p class="label">Medium</p>
            <p>{d.medium}</p>
          </div>
        )
      }
      {
        (d.vimeo || d.youtube) && (
          <div>
            <p class="label">Film</p>
            <p>
              <a
                href={d.youtube ? `https://www.youtube.com/watch?v=${d.youtube}` : d.vimeo}
                rel="noopener"
              >
                Watch on {d.youtube ? 'YouTube' : 'Vimeo'} &rarr;
              </a>
            </p>
          </div>
        )
      }
    </aside>
  </section>

  {
    (d.vimeo || d.youtube) && d.hero && (
      <section class="wrap film">
        <VideoFacade
          vimeo={d.vimeo}
          youtube={d.youtube}
          poster={d.hero}
          posterAlt={d.heroAlt ?? ''}
          title={d.title}
        />
      </section>
    )
  }

  {
    d.howItWorks.length > 0 && (
      <section class="band how">
        <div class="wrap inner">
          <p class="kicker">How it works</p>
          <ol role="list" class="stagger">
            {d.howItWorks.map((step, i) => (
              <li class="reveal">
                <span class="num" aria-hidden="true">
                  {i + 1}
                </span>
                <h2>{step.title}</h2>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    d.gallery.length > 0 && (
      <section class="wrap gallery">
        {d.gallery.map((g) => (
          <Image
            src={g.src}
            alt={g.alt}
            width={1200}
            widths={[600, 1200]}
            sizes="(max-width: 720px) 100vw, 48vw"
          />
        ))}
      </section>
    )
  }

  {
    d.credits.length > 0 && (
      <section class="credits-band">
        <div class="wrap inner">
          <div class="credits">
            <p class="kicker">Credits</p>
            <ul role="list">
              {d.credits.map((c) => (
                <li>
                  <span class="role">{c.role}</span> — {c.name}
                </li>
              ))}
            </ul>
          </div>
          <p class="next">
            Next project: <a href={withBase(`/work/${next.id}/`)}>{next.data.title} &rarr;</a>
          </p>
        </div>
      </section>
    )
  }

  <ContactCTA heading="Bring this to your <em>community</em>." />
</Base>

<style>
  /* Photography treatment: this band stays dark regardless of theme —
     the image needs the scrim, and the scrim needs the dark ground. */
  .hero {
    position: relative;
    background-color: var(--mist);
    color: var(--ink);
    min-height: clamp(300px, 38vw, 400px);
    display: flex;
    align-items: flex-end;
  }

  /* The pixel field fades out under the title, so the copy sits on clean
     ground — the same quiet zone the home hero carves for its text. */
  .hero:not(.has-photo)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--mist) 0%,
      var(--mist) 26%,
      color-mix(in srgb, var(--mist) 82%, transparent) 46%,
      transparent 78%
    );
    pointer-events: none;
  }

  .title-block {
    z-index: 1;
  }

  /* Photography treatment: a photo hero stays dark regardless of theme —
     the image needs the scrim, and the scrim needs the dark ground. */
  .hero.has-photo {
    display: block;
    background-color: var(--band);
    color: var(--band-ink);
  }

  .hero img {
    width: 100%;
    height: clamp(360px, 55vw, 560px);
    object-fit: cover;
    opacity: 0.55;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      rgba(10, 16, 22, 0.8) 0%,
      rgba(10, 16, 22, 0.15) 40%,
      rgba(10, 16, 22, 0.92) 100%
    );
  }

  .title-block {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(44px, 6vw, 64px) clamp(32px, 5vw, 56px);
  }

  .has-photo .title-block {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding-block: 0 clamp(32px, 5vw, 56px);
  }

  h1 {
    font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    line-height: 1;
  }

  .tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    color: var(--cyan-text);
    max-width: 44ch;
  }

  .has-photo .tagline {
    color: var(--mint);
  }

  .context {
    display: flex;
    gap: clamp(40px, 6vw, 80px);
    align-items: flex-start;
    flex-wrap: wrap;
    padding-block: clamp(56px, 8vw, 88px);
  }

  .prose {
    flex: 2;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .prose :global(p) {
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.2em;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .meta {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--paper-2);
    border-radius: 16px;
    padding: 32px;
  }

  .label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 4px;
  }

  .meta p:not(.label) {
    font-weight: 500;
  }

  .film {
    padding-block: 0 clamp(40px, 6vw, 64px);
  }

  .how {
    background-image: radial-gradient(
      ellipse 600px 300px at 20% 0%,
      rgba(0, 151, 178, 0.07),
      transparent 70%
    );
  }

  .how .inner {
    padding-block: clamp(56px, 8vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .how ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 44px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .how li {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.8rem;
    color: var(--cyan);
  }

  .how h2 {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .how p {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    padding-block: clamp(56px, 8vw, 88px);
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }

  .credits-band {
    background: var(--paper-2);
  }

  .credits-band .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    padding-block: clamp(48px, 7vw, 72px);
  }

  .credits {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .credits ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .role {
    font-weight: 500;
    color: var(--ink);
  }

  .next {
    font-size: 0.95rem;
  }
</style>
