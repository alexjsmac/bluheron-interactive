---
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import BeaconMark from '../components/BeaconMark.astro';

const work = (await getCollection('work'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const partners = [
  'Canadian Museums Association',
  'Centre[3] for Artistic + Social Practice',
  'City of Hamilton',
  'Canadian Ocean Literacy Coalition',
  'Nuit Blanche London',
  'Supercrawl',
];
---

<Base
  title="BluHeron Interactive — Art, technology & accessibility"
  description="A creative technology studio in London & Hamilton, Ontario, making art, places, and stories accessible to everyone — immersive installations, the beacbeac platform, and digital services for arts organizations."
>
  <HeroCanvas tall>
    <div class="hero rise">
      <p class="kicker">A creative technology studio<span class="where"> &middot; London &amp; Hamilton, Ontario</span></p>
      <h1 class="display">We make art, places, and stories <em>everyone</em> can enter.</h1>
      <p class="lede">
        BluHeron Interactive ignites community interaction through immersive, inclusive
        experiences — from projection and sound installations to beacbeac, our accessibility
        platform for public places.
      </p>
      <div class="actions">
        <a class="btn" href={withBase('/work/')}>See our work</a>
        <a class="arrow-link" href={withBase('/beacbeac/')}>Meet beacbeac &rarr;</a>
      </div>
    </div>
  </HeroCanvas>

  <section class="wrap pillars">
    <p class="kicker">What we do</p>
    <div class="grid stagger">
      <div class="pillar reveal">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M12 3 L21 8.5 L12 14 L3 8.5 Z"></path>
          <path d="M3 13 L12 18.5 L21 13"></path>
        </svg>
        <h2>Immersive experiences &amp; installations</h2>
        <p>
          Interactive projection, generative sound, and playful public sculpture — co-created
          with the communities they're built for.
        </p>
      </div>
      <div class="pillar reveal">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="2.5"></circle>
          <path d="M7.5 7.5 a6.5 6.5 0 0 1 9 0"></path>
          <path d="M5 5 a10 10 0 0 1 14 0" opacity="0.55"></path>
        </svg>
        <h2>beacbeac — access, amplified</h2>
        <p>
          Our flagship platform delivers place-based stories and audio to visitors' phones as
          they approach. No QR codes. Nothing to hunt for.
        </p>
      </div>
      <div class="pillar reveal">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 17 L9 11 L13 14 L20 6"></path>
          <path d="M15 6 L20 6 L20 11"></path>
        </svg>
        <h2>Digital services for arts organizations</h2>
        <p>
          Websites, hosting, and accessibility audits for arts councils, galleries, and
          festivals — the same care, behind the scenes.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap work">
    <div class="row">
      <h2 class="section-title">Selected work</h2>
      <a class="arrow-link" href={withBase('/work/')}>All work &rarr;</a>
    </div>

    <a class="flagship band reveal" href={withBase('/beacbeac/')}>
      <div class="flag-copy">
        <div class="tags" aria-hidden="true">
          <span>Flagship</span>
          <span>Platform</span>
        </div>
        <h3>beacbeac: <em>art that finds you</em></h3>
        <p>
          Every place has stories. beacbeac makes them accessible to everyone — touring Ability
          First Fest, Supercrawl, and Nuit Blanche London in fall 2026.
        </p>
        <span class="arrow-link">Explore beacbeac &rarr;</span>
      </div>
      <span class="ripples">
        <BeaconMark size={220} />
      </span>
    </a>

    <div class="cards">
      {work.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="wrap partners">
    <p class="kicker muted-kicker">In good company</p>
    <ul role="list">
      {partners.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <ContactCTA />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 34px;
    max-width: 1060px;
  }

  .hero h1 {
    font-size: clamp(3rem, 7.4vw, 6.5rem);
    line-height: 1.02;
  }

  @media (max-width: 720px) {
    .hero {
      gap: 24px;
    }

    .hero h1 {
      font-size: 2.5rem;
      line-height: 1.06;
    }

    /* The eyebrow stays one line; the location lives in the footer. */
    .where {
      display: none;
    }

    .lede {
      font-size: 1.0625rem;
    }

    .actions {
      gap: 20px;
      margin-top: 4px;
    }
  }

  /* Short screens (small phones, landscape): pull the headline in further
     so a call to action still lands on the first screen. */
  @media (max-width: 720px) and (max-height: 640px) {
    .hero h1 {
      font-size: 2.1rem;
    }

    .hero {
      gap: 18px;
    }
  }

  .lede {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 54ch;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .pillars {
    padding-block: clamp(72px, 10vw, 128px) clamp(32px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pillar h2 {
    font-size: 1.55rem;
  }

  .pillar p {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .work {
    padding-block: clamp(48px, 7vw, 88px) clamp(72px, 10vw, 128px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .flagship {
    display: flex;
    align-items: center;
    gap: clamp(48px, 6vw, 80px);
    border-radius: 20px;
    border: 1px solid var(--mist-line);
    padding: clamp(32px, 5vw, 64px);
    text-decoration: none;
    color: var(--ink);
    background-image: radial-gradient(
      ellipse 500px 300px at 85% 30%,
      rgba(0, 151, 178, 0.08),
      transparent 70%
    );
  }

  .flag-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1;
  }

  .tags {
    display: flex;
    gap: 10px;
  }

  .tags span {
    border: 1px solid var(--mist-line);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-text);
  }

  .flagship h3 {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
  }

  .flagship:hover h3 {
    color: var(--cyan-text);
  }

  .flagship p {
    color: var(--ink-2);
    max-width: 52ch;
  }

  .ripples {
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .ripples {
      display: none;
    }
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .cards {
      grid-template-columns: 1.18fr 1fr;
      gap: 44px;
      align-items: start;
    }

    .cards > :global(:nth-child(2)) {
      margin-top: 72px;
    }
  }

  .partners {
    padding-block: clamp(64px, 9vw, 104px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .muted-kicker {
    color: var(--muted);
  }

  .partners ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.3vw, 1.8rem);
    color: var(--muted);
  }

  .partners li::after {
    content: '·';
    margin-left: 22px;
    color: var(--clay);
  }

  .partners li:last-child::after {
    content: '';
    margin: 0;
  }
</style>
