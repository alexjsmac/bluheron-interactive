---
import { withBase } from '../lib/url';
import { GA_MEASUREMENT_ID } from '../lib/analytics';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/dm-sans/standard-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Site-root path to a share image; falls back to the brand card. */
  image?: string;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image ?? '/og-default.jpg', Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="BluHeron Interactive" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <ClientRouter />
    <script is:inline>
      // Runs before paint: honour a saved theme choice, and mark JS available.
      function applySavedTheme() {
        document.documentElement.classList.remove('no-js');
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.dataset.theme = theme;
          }
        } catch {}
      }
      applySavedTheme();
      // astro:after-swap replaces the <html> element's attributes on
      // client-side navigation, so re-apply the saved theme after every swap.
      document.addEventListener('astro:after-swap', applySavedTheme);
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'BluHeron Interactive',
        url: 'https://bluheroninteractive.com',
        logo: 'https://bluheroninteractive.com/logo.png',
        description:
          'A creative technology studio making art, places, and stories accessible to everyone. London & Hamilton, Ontario.',
        sameAs: ['https://www.instagram.com/bluheroninteractive'],
      })}
    />
    {
      /* GA4, configured cookieless — mirrors the pattern already proven on
         beacbeac.com's marketing site.

         Consent Mode with analytics_storage denied, declared BEFORE config
         (defaults only apply to a measurement id configured after them). GA4
         then sends cookieless pings and writes nothing to the device, which is
         what keeps this site free of a consent banner. The cost is that
         returning visitors are not recognised, so "users" trends toward
         "sessions". Do not relax this without shipping a banner.

         send_page_view:false plus a manual page_view on astro:page-load. The
         ClientRouter writes to the History API several times per navigation,
         and anything that counts those writes reports duplicates labelled with
         the URL of the page being left — measured, when Cloudflare's beacon
         was here. Driving the pageview from astro:page-load instead fires once
         per navigation, after the swap, so the path is the one arrived at.
         GA4's Enhanced Measurement "page changes based on browser history
         events" must stay OFF in the data stream settings or it re-introduces
         exactly that duplication.

         The window guard survives soft navigation, so consent, config, and the
         listener are registered once even though head scripts re-run on swap;
         transition:persist keeps the gtag.js element from being re-inserted. */
      GA_MEASUREMENT_ID && (
        <>
          <script
            is:inline
            transition:persist
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            if (!window.__gaInit) {
              window.__gaInit = true;
              gtag('consent', 'default', {
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied',
                analytics_storage: 'denied',
              });
              gtag('js', new Date());
              gtag('config', gaId, { anonymize_ip: true, send_page_view: false });
              document.addEventListener('astro:page-load', function () {
                gtag('event', 'page_view', {
                  page_location: location.href,
                  page_path: location.pathname,
                  page_title: document.title,
                });
              });
            }
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveals — enhancement only, skipped for reduced motion.
      // Re-run on every ClientRouter navigation: scripts execute once per
      // site visit, and the previous IntersectionObserver was watching
      // elements from the page that just got swapped out.
      function initReveals() {
        if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px' }
          );
          document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
        } else {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        }
      }

      initReveals();
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>
